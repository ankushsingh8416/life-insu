#############################################
# Sabse Pehle Life Insurance AI Assistant
# Environment Configuration
# Copy this file to .env and fill in real values.
#
# PRODUCTION CHECKLIST — before deploying anywhere real:
#   [ ] Every "change_me_..." value below replaced with a real random secret
#       (JWT_SECRET, JWT_REFRESH_SECRET, COOKIE_SECRET, POSTGRES_PASSWORD,
#       REDIS_PASSWORD) — generate with `openssl rand -hex 32`.
#   [ ] OPENAI_API_KEY / GEMINI_API_KEY are keys you control, with billing/quota
#       verified working — never reuse a key that touched a shared/dev session.
#   [ ] CORS_ORIGIN lists your real frontend domain(s), not localhost
#       (e.g. https://sabsepehlelifeinsurance.com,https://your-app.vercel.app).
#   [ ] NEXT_PUBLIC_API_URL / NEXT_PUBLIC_SOCKET_URL point at your real deployed
#       API URL (https://..., not localhost) — these are baked in at build time.
#   [ ] NODE_ENV=production
#   [ ] DATABASE_URL / QDRANT_URL point at managed services if you're not
#       self-hosting them (Railway Postgres, Qdrant Cloud, etc).
#############################################

# ---------- General ----------
NODE_ENV=development
APP_NAME="Sabse Pehle Life Insurance AI Assistant"
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---------- Postgres ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=sabsepehle
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=sabsepehle_ai
DATABASE_URL=postgresql://sabsepehle:change_me_strong_password@postgres:5432/sabsepehle_ai?schema=public

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password
REDIS_URL=redis://:change_me_redis_password@redis:6379

# ---------- Qdrant (Vector DB) ----------
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=insurance_knowledge_base

# ---------- AI Provider Layer ----------
# Which provider handles chat completions by default.
# One of: openai | gemini
AI_PRIMARY_PROVIDER=openai
AI_SECONDARY_PROVIDER=gemini
AI_FALLBACK_PROVIDER=gemini-flash

# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Gemini
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-pro
GEMINI_FLASH_MODEL=gemini-2.5-flash

# Shared generation defaults (used unless overridden by admin AI Settings in DB)
AI_TEMPERATURE=0.2
AI_TOP_P=0.9
AI_FREQUENCY_PENALTY=0
AI_PRESENCE_PENALTY=0
AI_MAX_TOKENS=1024

# RAG
RAG_TOP_K=10
RAG_MIN_SIMILARITY=0.72
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120

# ---------- AWS S3 ----------
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=sabsepehle-ai-knowledge-base

# ---------- Auth / Security ----------
JWT_SECRET=change_me_jwt_secret_min_32_chars
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=change_me_cookie_secret
CORS_ORIGIN=http://localhost,http://localhost:3000
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=60

# ---------- Google Analytics ----------
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ---------- Socket.IO ----------
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# ---------- Crawler ----------
CRAWLER_WEBSITE_SCHEDULE_CRON="0 2 * * *"
CRAWLER_IRDAI_SCHEDULE_CRON="0 */12 * * *"
IRDAI_BASE_URL=https://irdai.gov.in
COMPANY_WEBSITE_BASE_URL=https://sabsepehlelifeinsurance.com
